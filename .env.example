AGENT_PATTERNS_ENVIRONMENT=local
AGENT_PATTERNS_LOG_LEVEL=INFO
AGENT_PATTERNS_CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agent_patterns
AGENT_PATTERNS_REVIEWER_API_KEY=
AGENT_PATTERNS_REVIEWER_ID=local-reviewer
AGENT_PATTERNS_TENANT_ID=tenant-alpha
AGENT_PATTERNS_REDIS_URL=redis://localhost:6379/0
AGENT_PATTERNS_CACHE_TTL_SECONDS=3600
AGENT_PATTERNS_CACHE_VECTOR_DIMENSIONS=128
AGENT_PATTERNS_CACHE_SEMANTIC_DISTANCE_THRESHOLD=0.12
AGENT_PATTERNS_CACHE_REQUIRED=true
AGENT_PATTERNS_DEPENDENCY_TIMEOUT_SECONDS=0.5
# AGENT_PATTERNS_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# make eval always uses the deterministic stub; eval-live uses these settings.
AGENT_PATTERNS_PROVIDER_MODE=deterministic
AGENT_PATTERNS_PROVIDER_API_KEY=
AGENT_PATTERNS_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AGENT_PATTERNS_PROVIDER_MODEL=gemini-3.7-flash
AGENT_PATTERNS_PROVIDER_JUDGE_MODEL=gemini-3.7-flash
AGENT_PATTERNS_PROVIDER_TEMPERATURE=0.1
AGENT_PATTERNS_PROVIDER_JUDGE_TEMPERATURE=0
AGENT_PATTERNS_PROVIDER_SEED=42
# Gemini compatibility docs do not guarantee seed support; seed is not sent.
AGENT_PATTERNS_PROVIDER_SEED_SUPPORTED=false
AGENT_PATTERNS_PROVIDER_TIMEOUT_SECONDS=120
AGENT_PATTERNS_PROVIDER_MAX_RETRIES=3
# Start with at most 5 requests/minute; adjust to your AI Studio project quota.
AGENT_PATTERNS_PROVIDER_MIN_INTERVAL_SECONDS=12
AGENT_PATTERNS_PROVIDER_RETRY_BACKOFF_SECONDS=12
AGENT_PATTERNS_PROVIDER_CACHE_DIR=evals/raw
# Conservative paid-price accounting as of 2026-10-06 (not an invoice).
# Selected fallback: same-model Flash judge (self-preference bias).
# Optional latest agent: gemini-3.8-flash; optional judge: gemini-3.1-pro-preview.
# Pro has no free API tier. 2.5 Flash is unavailable to new users.
# This project never enables billing.
AGENT_PATTERNS_PROVIDER_INPUT_USD_PER_MILLION=0.75
AGENT_PATTERNS_PROVIDER_OUTPUT_USD_PER_MILLION=3.75
AGENT_PATTERNS_PROVIDER_JUDGE_INPUT_USD_PER_MILLION=0.75
AGENT_PATTERNS_PROVIDER_JUDGE_OUTPUT_USD_PER_MILLION=3.75
AGENT_PATTERNS_EVAL_MAX_COST_USD=2.90
AGENT_PATTERNS_INCIDENT_DATA_PATH=evals/data/incidents.json
AGENT_PATTERNS_TICKET_DATABASE_PATH=data/tickets.sqlite3
# Conservative cap rate must be >= the chosen model's input and output USD/million rates.
AGENT_PATTERNS_TOKEN_PRICE_USD_PER_MILLION=12
