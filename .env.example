AGENT_PATTERNS_ENVIRONMENT=local
AGENT_PATTERNS_LOG_LEVEL=INFO
AGENT_PATTERNS_REDIS_URL=redis://localhost:6379/0
AGENT_PATTERNS_CACHE_TTL_SECONDS=3600
AGENT_PATTERNS_CACHE_VECTOR_DIMENSIONS=128
AGENT_PATTERNS_CACHE_SEMANTIC_DISTANCE_THRESHOLD=0.12
AGENT_PATTERNS_CACHE_REQUIRED=true
AGENT_PATTERNS_DEPENDENCY_TIMEOUT_SECONDS=0.5
